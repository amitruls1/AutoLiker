{
  "name": "Auto Date Liker",
  "version": "4.0",
  "description": "Auto-like profiles on Tinder, Bumble, Happn & OKCupid with smart controls",
  "manifest_version": 3,
  "minimum_chrome_version": "88",
  "permissions": ["activeTab", "storage", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.tinder.com/*",
        "*://*.bumble.com/*",
        "*://*.happn.com/*",
        "*://*.okcupid.com/*"
      ],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Auto Date Liker",
    "default_icon": "icon.png"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
